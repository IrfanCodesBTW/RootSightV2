# =============================================================================
# RootSight — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- LLM Configuration ---
GEMINI_API_KEY= your genini key here 
GEMINI_MODEL=gemini-2.5-flash

# --- Demo Mode ---
# When true, uses mock data instead of real API calls
DEMO_MODE=true

# --- Datadog (optional, only needed when DEMO_MODE=false) ---
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# --- PagerDuty (optional, only needed when DEMO_MODE=false) ---
PAGERDUTY_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
